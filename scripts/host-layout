#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Query or set the keyboard's host layout over its raw HID API.

  host-layout                            print the active layout (us, ca, ...)
  host-layout set ca                     set the layout
  host-layout arrangement                print the active layout's arrangement
                                         (qwerty, colemak-dh, ...)
  host-layout arrangement set colemak-dh set it, within the active layout
  host-layout watch                      sync the keyboard to Hyprland's
                                         layout, now and on every change
                                         (run via exec-once)

The raw interface is found by report descriptor: usage page 0xFF60, usage
0x61, QMK's raw HID.
"""
import glob
import json
import os
import select
import socket
import string
import sys
import time

QMK_RAW_DESCRIPTOR_PREFIX = bytes([0x06, 0x60, 0xFF, 0x09, 0x61])
REPORT_SIZE = 32
GET_LAYOUT = 0x01
SET_LAYOUT = 0x02
GET_ARRANGEMENT = 0x03
SET_ARRANGEMENT = 0x04
ERROR_RESPONSE = 0xFF

WATCH_DEVICE = "charybdis"
OS_LAYOUT_NAMES = {
    "English (US)": "us",
    "Canadian (CSA)": "ca",
}

REJECTED = object()
DENIED = object()

LAYOUT_NAME_CHARS = set(string.ascii_lowercase + string.digits + "_-")
LAYOUT_NAME_MAX = REPORT_SIZE - 2


def qmk_raw_nodes():
    def index(path):
        return int(path.rsplit("hidraw", 1)[1])

    for sysdir in sorted(glob.glob("/sys/class/hidraw/hidraw*"), key=index):
        try:
            with open(f"{sysdir}/device/report_descriptor", "rb") as f:
                prefix = f.read(len(QMK_RAW_DESCRIPTOR_PREFIX))
        except OSError:
            continue
        if prefix == QMK_RAW_DESCRIPTOR_PREFIX:
            yield f"/dev/{os.path.basename(sysdir)}"


def query(node, command, payload=b""):
    """Round-trip one report on a hidraw node.

    Return the response payload, REJECTED if the firmware answered with an
    error report, or None on timeout or a foreign reply. Raise OSError when
    the node cannot be opened or accessed.
    """
    fd = os.open(node, os.O_RDWR)
    try:
        request = bytes([command]) + payload
        request += b"\x00" * (REPORT_SIZE - len(request))
        # NOTE: the leading zero byte is the report id (unnumbered).
        os.write(fd, b"\x00" + request)
        if not select.select([fd], [], [], 1.0)[0]:
            return None
        response = os.read(fd, REPORT_SIZE)
        if len(response) < 3:
            return None
        if response[0] == ERROR_RESPONSE:
            return REJECTED
        if response[0] != command:
            return None
        # NOTE: other QMK boards (VIA) share the raw HID descriptor and echo
        # our command byte with foreign data; accept only a plausible name.
        name = response[2:].split(b"\x00")[0].decode(errors="replace")
        if not name or not set(name) <= LAYOUT_NAME_CHARS:
            return None
        return name
    finally:
        os.close(fd)


def run(command, payload=b""):
    """Issue a command against the first QMK raw HID device that answers.

    Return the reply payload, REJECTED if a device answered with an error,
    DENIED if a device was unreadable, or None if no device responded.
    """
    rejected = denied = False
    for node in qmk_raw_nodes():
        try:
            result = query(node, command, payload)
        except PermissionError:
            denied = True
            continue
        except OSError:
            continue
        if result is REJECTED:
            rejected = True
        elif result:
            return result
    if rejected:
        return REJECTED
    if denied:
        return DENIED
    return None


def hypr_connect():
    """Connect to the live Hyprland event socket.

    Return (socket, instance dir), or None when no instance answers.
    HYPRLAND_INSTANCE_SIGNATURE can be stale (dead instance dirs linger in
    the runtime dir), so fall back to probing every instance.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    instances = []
    if signature := os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        instances.append(f"{runtime}/hypr/{signature}")
    instances += sorted(glob.glob(f"{runtime}/hypr/*"),
                        key=os.path.getmtime, reverse=True)
    for instance in instances:
        sock = socket.socket(socket.AF_UNIX)
        try:
            sock.connect(f"{instance}/.socket2.sock")
            return sock, instance
        except OSError:
            sock.close()
    return None


def sync_to_os(instance):
    """Set the firmware to the OS layout Hyprland reports for the keyboard."""
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.connect(f"{instance}/.socket.sock")
            sock.sendall(b"j/devices")
            raw = b""
            while chunk := sock.recv(8192):
                raw += chunk
        for keyboard in json.loads(raw)["keyboards"]:
            if WATCH_DEVICE in keyboard["name"]:
                layout = OS_LAYOUT_NAMES.get(keyboard["active_keymap"])
                if layout:
                    run(SET_LAYOUT, layout.encode())
                return
    except (OSError, ValueError, KeyError):
        pass


def stream_events(sock):
    buffer = b""
    while chunk := sock.recv(4096):
        buffer += chunk
        while b"\n" in buffer:
            line, buffer = buffer.split(b"\n", 1)
            # NOTE: other events carry client-controlled bytes (window
            # titles) that may not be valid UTF-8; never decode those.
            if not line.startswith(b"activelayout>>"):
                continue
            device, _, os_layout = line.decode(errors="replace")[14:].partition(",")
            if WATCH_DEVICE not in device:
                continue
            layout = OS_LAYOUT_NAMES.get(os_layout)
            if layout:
                run(SET_LAYOUT, layout.encode())


def watch():
    connected = hypr_connect()
    if connected is None:
        raise SystemExit("no running Hyprland instance")
    while connected is not None:
        sock, instance = connected
        with sock:
            sync_to_os(instance)
            stream_events(sock)
        # NOTE: EOF means Hyprland went away; wait for a new instance.
        time.sleep(2)
        connected = hypr_connect()


def main():
    args = sys.argv[1:]
    if args == ["watch"]:
        watch()
        return 0
    # NOTE: a leading "arrangement" selects the second command family; the
    # get/set grammar is the same for both.
    if args and args[0] == "arrangement":
        noun, get_command, set_command = "arrangement", GET_ARRANGEMENT, SET_ARRANGEMENT
        args = args[1:]
    else:
        noun, get_command, set_command = "layout", GET_LAYOUT, SET_LAYOUT
    if not args:
        command, payload = get_command, b""
    elif args[0] == "set" and len(args) == 2:
        command, payload = set_command, args[1].encode()
        if len(payload) > LAYOUT_NAME_MAX:
            print(f"{noun} name too long (max {LAYOUT_NAME_MAX} bytes)", file=sys.stderr)
            return 2
    else:
        print(__doc__.rstrip(), file=sys.stderr)
        return 2
    result = run(command, payload)
    if isinstance(result, str):
        print(result)
        return 0
    if result is REJECTED:
        if command == set_command:
            print(f"rejected: unknown {noun} {args[1]}", file=sys.stderr)
        else:
            print("rejected by keyboard", file=sys.stderr)
        return 1
    print("no keyboard", file=sys.stderr)
    if result is DENIED:
        print("hint: /dev/hidraw* is not accessible, grant access with a udev rule",
              file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
